general {
    colors = true
    interval = 1
}

order += 'ipv6'
order += 'ethernet _first_'
order += 'disk /'
order += 'memory'
order += 'cpu_usage'
order += 'tztime local'

ipv6 {
    format_up = 'IPv6: %ip'
    format_down = 'IPv6: down'
}

ethernet _first_ {
    format_up = 'E: %ip (%speed)'
    format_down = 'E: down'
}

disk '/' {
    format = 'Disk: %percentage_used (%used / %total)'
}

memory {
    format = 'Mem: %percentage_used (%used / %total)'
}

cpu_usage {
    format = 'CPU: %usage'
}

tztime local {
    format = '%Y-%m-%d %H:%M:%S'
}

