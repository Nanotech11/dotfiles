general {
    colors = true
    interval = 1
}

# The order defines what appears from left to right on your bar
order += "ipv6"
order += "ethernet _first_"
order += "disk /"
order += "memory"
order += "cpu_usage"
order += "tztime local"

# IPv6 configuration
ipv6 {
    format_up = "IPv6: %ip"
    format_down = "IPv6: down"
}

# Network (IPv4)
ethernet _first_ {
    format_up = "E: %ip"
    format_down = "E: down"
}

# Disk usage in GB Used / GB Total
disk "/" {
    format = "Disk: %used / %total"
}

# Memory usage in GB Used / GB Total
memory {
    format = "Mem: %used / %total"
    threshold_degraded = "10%"
    format_degraded = "MEMORY LOW: %free"
}

# CPU Utilization
cpu_usage {
    format = "CPU: %usage"
}

tztime local {
    format = "%Y-%m-%d %H:%M:%S"
}

